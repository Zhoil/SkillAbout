# hot-search-skill 环境变量（复制为 .env；不填也能跑只读热点采集）
#
# ── GitHub ──────────────────────────────────────────────────────────────────
# GitHub API token，提高 rate limit；只读 repo/search 请求使用。
GITHUB_TOKEN=
#
# 本地快照目录，默认 ~/.hot-search-skill
HOT_SEARCH_STATE_DIR=
#
# ── 消息推送渠道（按需填写，未使用的留空即可）────────────────────────────────
#
# 飞书自定义机器人 webhook
NOTIFY_FEISHU_WEBHOOK=
#
# 钉钉自定义机器人 webhook + 加签 secret（未开启加签时 secret 留空）
NOTIFY_DINGTALK_WEBHOOK=
NOTIFY_DINGTALK_SECRET=
#
# 企业微信群机器人 webhook
NOTIFY_WECOM_WEBHOOK=
#
# Slack Incoming Webhook
NOTIFY_SLACK_WEBHOOK=
#
# Telegram Bot token 和目标 chat_id（私聊/群组/频道均可）
NOTIFY_TELEGRAM_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
#
# Discord Webhook
NOTIFY_DISCORD_WEBHOOK=
#
# Microsoft Teams Incoming Webhook
NOTIFY_TEAMS_WEBHOOK=
#
# 通用 HTTP webhook（POST JSON）
NOTIFY_GENERIC_WEBHOOK=
